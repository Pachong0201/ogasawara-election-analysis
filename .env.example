# Feishu custom-app credentials. Never commit real secrets.
LARK_APP_ID=
LARK_APP_SECRET=

# Optional OpenAI API. Without it the bot returns deterministic structural summaries.
OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=gpt-5.6-luna
OPENAI_WRITER_MODEL=gpt-5.6-sol

# Skill runtime
OGASAWARA_BOT_MODE=online
# Local corpus populated by python -m runtime.news_collector. gdelt is optional; disabled turns retrieval off.
OGASAWARA_BOT_RETRIEVAL=local
OGASAWARA_MAX_ARTICLE_FETCHES=6
OGASAWARA_TARGET_YEAR=2026
FEISHU_REQUIRE_MENTION=true
FEISHU_BOT_CONVERSATION_DB=cache/bot/conversations.sqlite3
