# Feishu custom-app credentials. Never commit real secrets.
LARK_APP_ID=
LARK_APP_SECRET=

# DeepSeek official OpenAI-compatible API. Without the key the bot returns
# deterministic structural summaries.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Skill runtime
OGASAWARA_BOT_MODE=online
# Local corpus populated by python -m runtime.news_collector. gdelt is optional; disabled turns retrieval off.
OGASAWARA_BOT_RETRIEVAL=local
OGASAWARA_MAX_ARTICLE_FETCHES=6
OGASAWARA_TARGET_YEAR=2026
FEISHU_REQUIRE_MENTION=true
FEISHU_BOT_CONVERSATION_DB=cache/bot/conversations.sqlite3

# Automatic research: DeepSeek plans/reads; Tavily performs real web searches.
# Set true after supplying both credentials. The same DeepSeek key is reused.
OGASAWARA_AUTO_RESEARCH=false
TAVILY_API_KEY=
RESEARCH_FOREGROUND_SECONDS=60
# Shared across processes using the same news DB; resets at UTC midnight.
RESEARCH_DAILY_SEARCHES=120
RESEARCH_DAILY_TOKEN_BUDGET=500000
