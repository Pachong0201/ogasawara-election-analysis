# Feishu custom-app credentials. Never commit real secrets.
LARK_APP_ID=
LARK_APP_SECRET=

# Recommended OpenCode Go configuration.
# One Go key is shared by the research planner, evidence review, analyst writer,
# and validator. Keep real keys only in your local .env or secret store.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Model roles when OpenCode Go is enabled.
# Planner: stronger reasoning for research questions and hypotheses.
RESEARCH_PLANNER_MODEL=glm-5.3
# Review: lower-cost evidence extraction / citation review.
RESEARCH_LLM_MODEL=deepseek-v4.1-flash
# Final prose synthesis. GPT 5.6 Luna uses the Responses endpoint on OpenCode Go.
ANALYST_WRITER_MODEL=gpt-5.6-luna
# Local evidence validator; defaults to chat/completions.
VALIDATOR_MODEL=deepseek-v4.1-flash
# auto routes models to their documented endpoint; override only for diagnostics.
ANALYST_WRITER_PROTOCOL=auto

# Tavily performs real web searches for automatic research.
TAVILY_API_KEY=

# Legacy / alternative direct DeepSeek configuration.
# These values are used when OPENCODE_GO_API_KEY is not set.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Skill runtime
OGASAWARA_BOT_MODE=online
# Local corpus populated by python -m runtime.news_collector. gdelt is optional; disabled turns retrieval off.
OGASAWARA_BOT_RETRIEVAL=local
OGASAWARA_MAX_ARTICLE_FETCHES=6
OGASAWARA_TARGET_YEAR=2026
FEISHU_REQUIRE_MENTION=true
FEISHU_BOT_CONVERSATION_DB=cache/bot/conversations.sqlite3

# Automatic research.
# auto enables research when a model key and TAVILY_API_KEY are available.
OGASAWARA_AUTO_RESEARCH=auto
RESEARCH_FOREGROUND_SECONDS=60
RESEARCH_MAX_QUERIES=8
RESEARCH_MAX_BODIES=30
# Shared across processes using the same news DB; resets at UTC midnight.
RESEARCH_DAILY_SEARCHES=120
RESEARCH_DAILY_TOKEN_BUDGET=500000
